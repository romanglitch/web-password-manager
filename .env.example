# Base URL used for generating absolute share links
# In production set this to your actual domain with https
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: secret for HMAC signing of temp link IDs (Variant A)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SIGNING_SECRET=change_me_to_a_random_32_byte_hex_string